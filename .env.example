# AI Judge — copy to .env.local and fill in secrets.
# Never commit .env.local.
#
# AI_JUDGE_MODE — force BYOK policy (optional; easiest way to test prod UX locally):
#   unset / empty → follow NODE_ENV (next dev = env-key fallback, next start = BYOK)
#   AI_JUDGE_MODE=dev  → always allow OPENROUTER_API_KEY from this file
#   AI_JUDGE_MODE=prod → require browser key (ignore env key) — even under next dev
#
# OPENROUTER_API_KEY is optional:
#   - AI_JUDGE_MODE=dev (default under next dev): used when the browser has no key
#   - AI_JUDGE_MODE=prod: ignored. Users paste their key in Settings (localStorage)

AI_JUDGE_MODE=
OPENROUTER_API_KEY=
# Optional dedicated key for live harness smokes. Never commit a real value.
OPENROUTER_SMOKE_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DATABASE_PATH=./data/ai-judge.sqlite

# Auth.js — JWT sessions (no SQLite adapter). Discord identify only.
# Discord works under next dev AND next start once the two Discord keys are set.
# Dev sign-in (extra local button) is registered only when AI_JUDGE_MODE=dev.
#
# Discord Developer Portal (you do this once):
#   1. https://discord.com/developers/applications → New Application
#   2. OAuth2 → copy Client ID and Client Secret
#      Portal labels: Client ID / Client Secret
#      This file:     AUTH_DISCORD_ID / AUTH_DISCORD_SECRET
#   3. OAuth2 → Redirects → add exactly (no trailing slash):
#        {AUTH_URL}/api/auth/callback/discord
#      Local:  http://localhost:3000/api/auth/callback/discord
#      If next binds another port, add that origin too (e.g. :3002).
#      Prod:   https://YOUR_DOMAIN/api/auth/callback/discord
#   4. Restart the Node process after saving env. Next does not hot-reload secrets.
#
# Production host (same Discord app is fine; add the prod redirect):
#   AUTH_URL=https://YOUR_DOMAIN
#   AUTH_SECRET=<new long random — not the machine-local value>
#   AUTH_DISCORD_ID / AUTH_DISCORD_SECRET from the portal
#   AI_JUDGE_MODE=prod
#   Never commit .env.local or host secrets in git.
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_URL=http://localhost:3000
